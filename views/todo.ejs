<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= selectedList.name %> · To-do</title>
    <meta name="theme-color" content="#071d36">
    <link rel="icon" type="image/svg+xml" href="/icons/logo.svg">
    <link rel="stylesheet" href="/css/captains-log.css">
    <link rel="stylesheet" href="/css/todo.css">
    <script src="https://unpkg.com/sortablejs@1.15.2/Sortable.min.js" defer></script>
    <script src="/js/todo.js" defer></script>
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <div class="site-title">
          <a href="/" class="site-title-link">
            <img src="/icons/logo.svg" alt="" class="site-logo">
            <span class="site-wordmark">Skibidi</span>
            <span class="brand-tagline">Where is Skibidi?</span>
          </a>
        </div>
        <nav class="tab-nav" aria-label="Primary navigation">
          <a href="/">Map</a>
          <a href="/logbook">Logbook</a>
          <a href="/to-do" aria-current="page">To Do</a>
        </nav>
        <div class="site-user">
          <% if (user) { %>
            <div class="user-menu">
              <button class="user-btn logged-in" id="user-menu-btn" type="button">
                <img src="<%= user._json.avatarUrl %>/170.png" alt="avatar" class="user-avatar">
              </button>
              <div class="user-dropdown" id="user-dropdown" style="display:none;">
                <form action="/auth/logout" method="get">
                  <button type="submit" class="logout-btn">Log out</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <a href="/auth/trello" class="user-btn">viewing</a>
          <% } %>
        </div>
      </header>

      <nav class="section-subnav" aria-label="To-do lists">
        <span class="section-subnav-label">Lists</span>
        <div class="section-subnav-items">
          <% lists.forEach(list => { %>
            <a
              href="/to-do?list=<%= encodeURIComponent(list.id) %>"
              class="section-subnav-link<%= list.id === selectedList.id ? ' active' : '' %>"
              <%= list.id === selectedList.id ? 'aria-current="page"' : '' %>
            >
              <span><%= list.name %></span>
              <% if (list.id === selectedList.id) { %>
                <span id="todo-count" class="section-subnav-count"><%= openCards.length %> open</span>
              <% } %>
            </a>
          <% }) %>
          <% if (user) { %>
            <button type="button" class="section-subnav-link todo-settings-button" id="todo-settings-button" aria-label="Manage to-do lists">
              <span>Settings</span>
            </button>
          <% } %>
        </div>
      </nav>

    <main class="todo-page" data-list-id="<%= selectedList.id %>">
      <% if (showListSwitcher) { %>
        <form id="add-item-form" class="add-item-form" novalidate>
          <label for="add-item-name" class="visually-hidden">New item</label>
          <input
            id="add-item-name"
            name="name"
            type="text"
            maxlength="512"
            placeholder="Add an item to <%= selectedList.name %>"
            autocomplete="off"
            required
          >
          <button type="submit">Add</button>
          <div id="add-item-matches" class="add-item-matches" hidden></div>
        </form>
      <% } %>

      <p id="todo-status" class="todo-status" role="status" aria-live="polite"></p>

      <section id="todo-list" class="todo-list" aria-label="Open to-do cards">
        <% openCards.forEach(card => { %>
          <%- include("partials/todo-card", { card, complete: false }) %>
        <% }) %>
      </section>

      <p id="todo-empty" class="todo-empty" <%= openCards.length ? "hidden" : "" %>>Everything is done.</p>

      <details class="done-section" <%= doneCards.length ? "open" : "" %>>
        <summary>Done <span id="done-count"><%= doneCards.length %></span></summary>
        <div id="done-list" class="todo-list done-list" aria-label="Done cards">
          <% doneCards.forEach(card => { %>
            <%- include("partials/todo-card", { card, complete: true }) %>
          <% }) %>
        </div>
        <p id="done-empty" class="done-empty" <%= doneCards.length ? "hidden" : "" %>>No completed items yet.</p>
      </details>
    </main>
    <% if (user) { %>
      <dialog id="todo-settings-dialog" class="todo-settings-dialog">
        <form id="todo-settings-form" method="dialog">
          <div class="todo-settings-heading">
            <div>
              <h2>To Do lists</h2>
              <p>Choose which open Trello lists appear in To Do.</p>
            </div>
            <button type="button" class="dialog-close" id="todo-settings-close" aria-label="Close settings">×</button>
          </div>
          <div id="todo-settings-lists" class="todo-settings-lists">
            <p>Loading lists…</p>
          </div>
          <p id="todo-settings-status" class="todo-status" role="status" aria-live="polite"></p>
          <div class="todo-settings-actions">
            <button type="button" id="todo-settings-cancel">Cancel</button>
            <button type="submit" class="primary">Save</button>
          </div>
        </form>
      </dialog>
    <% } %>
    </div>
  </body>
</html>
