<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>To-do</title>
    <link rel="icon" type="image/svg+xml" href="/icons/logo.svg">
    <link rel="stylesheet" href="/css/todo.css">
    <script src="/js/todo.js" defer></script>
  </head>
  <body>
    <main class="todo-page">
      <header class="todo-header">
        <div>
          <p class="eyebrow">Captain's Log</p>
          <h1>To-do</h1>
        </div>
        <span id="todo-count" class="todo-count"><%= cards.length %> open</span>
      </header>

      <p id="todo-status" class="todo-status" role="status" aria-live="polite"></p>

      <section id="todo-list" class="todo-list" aria-label="Open to-do cards">
        <% cards.forEach(card => { %>
          <article class="todo-card" data-card-id="<%= card.id %>">
            <div class="todo-card-content">
              <h2><%= card.name %></h2>
              <% if (card.desc) { %>
                <p class="todo-description"><%= card.desc %></p>
              <% } %>
              <% if ((card.labels && card.labels.length) || card.due) { %>
                <div class="todo-meta">
                  <% (card.labels || []).forEach(label => { %>
                    <span class="todo-label"><%= label.name || label.color %></span>
                  <% }) %>
                  <% if (card.due) { %>
                    <time datetime="<%= card.due %>">Due <%= new Date(card.due).toLocaleDateString() %></time>
                  <% } %>
                </div>
              <% } %>
            </div>
            <button type="button" class="done-button">Mark done</button>
          </article>
        <% }) %>
      </section>

      <p id="todo-empty" class="todo-empty" <%= cards.length ? "hidden" : "" %>>Everything is done.</p>
    </main>
  </body>
</html>
