<!–– Leaflet styles ––>
<head>
  <title>Where is...</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/icons/logo.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="mask-icon" href="/icons/logo.svg" color="#0c4a6e">
  <meta name="theme-color" content="#0c4a6e">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet/dist/leaflet.css"
/>
<link rel="stylesheet" href="https://unpkg.com/@fortawesome/fontawesome-free@6.4.2/css/all.min.css">
<link rel="stylesheet" href="/css/captains-log.css">
</head>

<main class="page">

<header class="site-header">
  <div class="site-title">
    <a href="https://where.is.achilleas.co.uk" class="site-title-link">
      <img src="/icons/logo.svg" alt="" class="site-logo">
      <span><small>Where is</small>Skibidi</span>
    </a>
  </div>
  <nav class="tab-nav" aria-label="Primary navigation">
    <button data-tab="planning" class="active">Chart</button>
    <button data-tab="historical">Voyages</button>
    <button data-tab="log">Logbook</button>
    <% if (user) { %>
      <a href="/to-do" class="tab-nav-link">To Do</a>
    <% } %>
  </nav>
  <div class="site-user">
   <% if (user) { %>
    <div class="user-menu">
      <button class="user-btn logged-in" id="user-menu-btn" type="button">
        <img src="<%= user._json.avatarUrl %>/170.png" alt="avatar" class="user-avatar">
      </button>
      <div class="user-dropdown" id="user-dropdown" style="display:none;">
        <form action="/auth/logout" method="get">
          <button type="submit" class="logout-btn">Log out</button>
        </form>
      </div>
    </div>
  <% } else { %>
    <a href="/auth/trello" class="user-btn">viewing</a>
  <% } %>
  </div>
</header>

<section id="planning" class="tab-content">
  <section id="live-journey" class="live-journey" aria-live="polite">
    <div class="live-journey-copy">
      <p id="live-journey-eyebrow" class="chartroom-eyebrow">Current position</p>
      <div class="live-journey-heading">
        <span id="live-journey-indicator" class="live-indicator" aria-hidden="true"></span>
        <h1 id="live-journey-title">Checking Skibidi’s position…</h1>
      </div>
      <p id="live-journey-message" class="live-journey-message">Connecting to the ship’s log.</p>
    </div>
    <dl class="live-journey-readings">
      <div><dt id="live-journey-updated-label">Last report</dt><dd id="live-journey-updated">—</dd></div>
      <div><dt id="live-journey-speed-label">Speed</dt><dd id="live-journey-speed">—</dd></div>
      <div><dt id="live-journey-course-label">Course</dt><dd id="live-journey-course">—</dd></div>
    </dl>
  </section>
  <div class="planning-flex">
    <div id="map"></div>
    <div class="table-col">
      <div class="controls">
        <label for="speed-input">
          <span class="speed-label">Speed</span>
          <input
            type="number"
            id="speed-input"
            value="6"
            min="1"
            step="0.5"
          >
          <span class="speed-units">knots</span>
        </label>
        <label class="toggle-label">
          <input type="checkbox" id="planned-only-toggle" checked>
          <span>Show only planned stops on map</span>
        </label>
      </div>
      <% if (user) { %>
        <section class="log-launch-panel">
          <div>
            <h3>Log</h3>
            <p class="muted">Record a location action in a few guided steps.</p>
          </div>
          <button type="button" id="open-log-wizard-btn" class="log-launch-btn">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
            Start a log
          </button>
        </section>
      <% } %>
      <div id="planning-summary" class="summary-panel"></div>
      <table id="planning-table" class="planning-table"></table>
    </div>
  </div>
</section>

<section id="historical" class="tab-content hidden">
  <% historical
  .sort((a, b) => b.year - a.year)
  .forEach(group => { %>
  <h3><%= group.year %></h3>
  <ul class="historical-trip-list">
    <% group.trips
      .sort((a, b) => new Date(b.start) - new Date(a.start))
      .forEach(t => { %>
      <li
        class="historical-trip-link"
        data-trip-name="<%= t.name %>"
        data-trip-start="<%= t.start ? new Date(t.start).toISOString() : '' %>"
        data-trip-end="<%= t.due ? new Date(t.due).toISOString() : '' %>"
      >
        <strong><%= t.name %></strong>
        <% if (t.start || t.due) { %>
          (
            <%= t.start ? new Date(t.start).toLocaleDateString() : '?' %>
            –
            <%= t.due   ? new Date(t.due).toLocaleDateString()   : '?' %>
          )
        <% } %>
      </li>
    <% }) %>
  </ul>
<% }) %>
</section>

<section id="log" class="tab-content hidden">
  <div class="log-layout">
    <div class="log-left">
      <div id="log-map"></div>
      <div id="log-controls">
        <button id="show-last-trip-btn">Show Current/Last Trip</button>
        <button id="show-all-logs-btn">Show All Logs</button>
      </div>
      <p id="log-loading-status" class="muted hidden" aria-live="polite"></p>
      <div id="log-summary" class="summary-panel"></div>
      <div id="diesel-info"></div>
      <div id="broken-items"></div>
    </div>
    <div id="log-list"></div>
  </div>
</section>
</main>

<% if (user) { %>
  <div id="log-wizard-modal" class="log-wizard-modal hidden" role="dialog" aria-modal="true" aria-labelledby="log-wizard-title">
    <div class="log-wizard-shell">
      <header class="log-wizard-header">
        <div>
          <span class="log-wizard-eyebrow">Skibidi</span>
          <h2 id="log-wizard-title">New log entry</h2>
        </div>
        <button type="button" id="close-log-wizard-btn" class="log-wizard-close" aria-label="Close log wizard">&times;</button>
      </header>

      <ol class="log-wizard-progress" aria-label="Log entry progress">
        <li data-wizard-progress="location">Location</li>
        <li data-wizard-progress="action">Action</li>
        <li data-wizard-progress="journey">Journey</li>
        <li data-wizard-progress="litres">Litres</li>
        <li data-wizard-progress="backfill">Backfill</li>
        <li data-wizard-progress="notification">Notification</li>
      </ol>

      <div class="log-wizard-content">
        <section class="log-wizard-step" data-wizard-step="location">
          <span class="log-wizard-step-count">Step 1 of 5</span>
          <h3>Where are you?</h3>
          <p class="muted">We’ll use your position to find the closest places.</p>
          <div id="wizard-location-status" class="wizard-status" role="status">Waiting to detect your location…</div>
          <div id="wizard-location-suggestions" class="wizard-location-list"></div>
          <button type="button" id="wizard-retry-location-btn" class="wizard-text-btn hidden">Try location again</button>
        </section>

        <section class="log-wizard-step hidden" data-wizard-step="action">
          <span class="log-wizard-step-count">Step 2 of 5</span>
          <h3>What happened?</h3>
          <p class="muted">Choose an action to continue.</p>
          <div id="wizard-action-grid" class="wizard-action-grid"></div>
        </section>

        <section class="log-wizard-step hidden" data-wizard-step="journey">
          <span class="log-wizard-step-count">Journey</span>
          <h3>Name this journey</h3>
          <p class="muted">We’ve suggested a name from your departure and planned destination. Change it if you like.</p>
          <label class="wizard-field" for="wizard-journey-name-input">
            <span>Journey name</span>
            <input type="text" id="wizard-journey-name-input" maxlength="160" autocomplete="off">
          </label>
        </section>

        <section class="log-wizard-step hidden" data-wizard-step="litres">
          <span class="log-wizard-step-count">Step 3 of 5</span>
          <h3>How many litres?</h3>
          <p class="muted">This is optional. Leave it empty to skip.</p>
          <label class="wizard-field" for="wizard-litres-input">
            <span>Litres</span>
            <div class="wizard-number-input">
              <input type="number" id="wizard-litres-input" min="0" step="1" inputmode="decimal" placeholder="e.g. 30">
              <span>litres</span>
            </div>
          </label>
        </section>

        <section class="log-wizard-step hidden" data-wizard-step="backfill">
          <span class="log-wizard-step-count">Step 4 of 5</span>
          <h3>Backfill the time?</h3>
          <p class="muted">Choose a historical date and time, or leave this empty to log it now.</p>
          <label class="wizard-field" for="wizard-backfill-input">
            <span>Date and time</span>
            <input type="datetime-local" id="wizard-backfill-input">
          </label>
          <button type="button" id="wizard-clear-backfill-btn" class="wizard-text-btn">Use current time</button>
        </section>

        <section class="log-wizard-step hidden" data-wizard-step="notification">
          <span class="log-wizard-step-count">Step 5 of 5</span>
          <h3>Send a notification?</h3>
          <p class="muted">The log is always saved. Choose who should receive the email update.</p>
          <div class="wizard-notification-options">
            <label class="wizard-choice-card">
              <input type="radio" name="wizard-notification" value="people">
              <span class="wizard-choice-icon"><i class="fa-solid fa-people-group" aria-hidden="true"></i></span>
              <span><strong>Notify people</strong><small>Email the configured notification list.</small></span>
            </label>
            <label class="wizard-choice-card">
              <input type="radio" name="wizard-notification" value="test">
              <span class="wizard-choice-icon"><i class="fa-solid fa-flask" aria-hidden="true"></i></span>
              <span><strong>Send test to me</strong><small>Email the configured reply-to address.</small></span>
            </label>
            <label class="wizard-choice-card">
              <input type="radio" name="wizard-notification" value="none">
              <span class="wizard-choice-icon"><i class="fa-solid fa-bell-slash" aria-hidden="true"></i></span>
              <span><strong>Don’t email</strong><small>Save the log entry only.</small></span>
            </label>
          </div>
          <div id="wizard-submit-status" class="wizard-status" role="status"></div>
        </section>

        <section class="log-wizard-step log-wizard-success hidden" data-wizard-step="success">
          <div class="wizard-success-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></div>
          <h3>Log saved</h3>
          <p id="wizard-success-message" class="muted">Skibidi has been updated.</p>
        </section>
      </div>

      <footer class="log-wizard-footer">
        <button type="button" id="wizard-back-btn" class="wizard-secondary-btn">Back</button>
        <button type="button" id="wizard-next-btn" class="wizard-primary-btn">Continue</button>
      </footer>
    </div>
  </div>
<% } %>

<!-– Leaflet core ––>
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet-polylinedecorator@1.6.0/dist/leaflet.polylineDecorator.min.js"></script>

<!-– Sortable core ––>
<script src="https://unpkg.com/sortablejs@1.15.2/Sortable.min.js"></script>

<!–– Your app JS ––>
<script src="/js/captains-log.js"></script>
